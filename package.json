{
  "name": "sadhak",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:goldens": "vitest run apps/api/src/sentinel/score.goldens.test.ts",
    "test:mutation": "stryker run",
    "test:load": "node tests/load/gate.mjs",
    "eval:triage": "pnpm --filter @sadhak/api exec tsx src/reviewer/evals/run.ts",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "seed": "pnpm --filter @sadhak/api seed",
    "db:generate": "pnpm --filter @sadhak/api db:generate",
    "db:push": "pnpm --filter @sadhak/api db:push",
    "db:migrate": "pnpm --filter @sadhak/api db:migrate",
    "db:studio": "pnpm --filter @sadhak/api db:studio",
    "check:env": "tsx scripts/check-env-example.ts",
    "check:docs": "tsx scripts/check-docs-honesty.ts",
    "docs:api": "tsx scripts/generate-api-reference.ts",
    "check:api": "tsx scripts/generate-api-reference.ts --check",
    "check:obs": "tsx scripts/check-observability.ts",
    "eval:historian": "SLACK_API_BASE_URL=http://127.0.0.1:39517 pnpm --filter @sadhak/api exec tsx src/historian/evals/run.ts",
    "check:claims": "tsx scripts/check-docs-claims.ts",
    "openapi:emit": "pnpm --filter @sadhak/api exec tsx scripts/emit-openapi.ts",
    "check:openapi": "pnpm --filter @sadhak/api exec tsx scripts/emit-openapi.ts --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.5",
    "@playwright/test": "^1.62.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.10.0",
    "fast-check": "^4.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.21",
      "sharp": "^0.35.0"
    }
  }
}
