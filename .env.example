# =============================================================================
# Sadhak environment. Copy to .env and fill in the two marked REQUIRED.
#
#   cp .env.example .env
#   echo "CREDENTIAL_MASTER_KEY=v1:$(openssl rand -base64 32)" >> .env
#
# Every variable below is read in exactly one place — apps/api/src/config.ts for
# the API, apps/web/lib/env.ts for the web app — and `pnpm check:env` fails CI if
# this file and that schema ever drift apart.
# =============================================================================

# ------------------------------------------------------------ REQUIRED (api)
# The one variable the API needs to boot. A malformed value exits at startup
# naming this variable, before any connection is opened. The value below is
# already correct for the Postgres in docker-compose.yml.
DATABASE_URL=postgres://sadhak:sadhak@localhost:5432/sadhak

# --------------------------------------------------- REQUIRED (to store creds)
# Seals connector credentials with AES-256-GCM before they touch the database.
# You generate this yourself; it is not issued by any provider:
#
#   echo "v1:$(openssl rand -base64 32)"
#
# Format is v1:<base64 of 32 bytes>. The `v1:` prefix is the key id every
# encrypted row records, which is what makes rotation a config change instead of
# an outage.
#
# Absent => the API still boots and the graph still works, but no credential can
# be stored, so `pnpm seed` connects nothing and there is no crawl.
#
# Back it up in a password manager as well as here. Losing it does not lose
# graph data — nodes, edges and rationale are unencrypted — but every stored
# connector credential becomes unreadable and each connector must be
# reconnected. Use a different key per environment.
# See docs/connectors/README.md.
CREDENTIAL_MASTER_KEY=
# Set only during a rotation window: new writes seal under the current key while
# rows sealed with this one keep opening.
CREDENTIAL_MASTER_KEY_PREVIOUS=

# =============================================================================
# Everything below has a working default. Set it only to change behaviour.
# =============================================================================

# ---------------------------------------------------------------- api server
NODE_ENV=development
PORT=3001
# Structured JSON on stdout, one line per event, correlated by request id.
# Raise to debug while chasing something. Health-check lines are debug, so at
# info the log is not 95% dokploy probes.
LOG_LEVEL=info
# Bearer token for GET /metrics (prometheus text format). Absent => the
# endpoint 404s. This api is internet-facing, and traffic volume, org counts
# and which callers are hitting their limits are not public facts. Generate
# with: openssl rand -hex 24
METRICS_TOKEN=

# Where to ship traces (OTLP/HTTP, no /v1/traces suffix — it is appended).
# Unset means the tracing SDK never starts: spans become no-ops rather than
# batching into a socket nobody is holding. Set it when a collector exists and
# traces begin flowing without a code change.
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Where the Historian's Slack tools point. Leave unset in every real
# deployment. The agent evals set it to a local fixture server so the agent's
# judgment can be scored against planted evidence.
SLACK_API_BASE_URL=

# Transactional and lifecycle email. Unset means nothing is sent and every
# would-be send is recorded in email_log with a reason, so the absence shows up
# in the data rather than only in this file.
RESEND_API_KEY=
MAIL_FROM=

# Where uncaught server errors are reported. Unset means the SDK never starts
# and nothing is sent. Errors only, never traces: Tempo owns tracing, and a
# 4xx is never reported at all because customer behaviour is not our defect.
SENTRY_DSN=

# The commit sha of the running image, set by the build (build-arg -> env).
# Left empty in dev on purpose: the code running is whatever is on disk, and a
# sha would describe it wrongly. Tags log lines and trace spans in production.
GIT_SHA=

# ------------------------------------------------------------------- auth
# Sessions are opaque tokens over Postgres-backed rows. The dev default is
# insecure on purpose, and production refuses to boot with it (config.ts).
SESSION_SECRET=
# Where the browser app runs. Drives CORS and the session cookie posture.
# Comma-separated: the apex and www. are different origins to a browser, so a
# deployment serving both lists both. Exact match, no wildcards.
WEB_ORIGINS=http://localhost:3000

# ----------------------------------------------------------------- egress
# Hostnames the SSRF guard may reach even though they resolve to private
# addresses. The prod stack crawls its own bundled n8n over the compose
# network, which is the whole reason this exists. Operator-set only: an org
# admin cannot add to it, or a tenant could allowlist their way to the cloud
# metadata endpoint at 169.254.169.254.
# `db` is here because the demo Postgres connector points at the stack's own
# database over the compose network, and the guard covers connection strings
# as well as HTTP. Set this to `localhost` instead when running the API outside
# compose against a local database.
EGRESS_ALLOW_PRIVATE_HOSTS=n8n,db

# ----------------------------------------------------------- rate limits
# Fixed one-minute windows. The per-IP tier is in-process (it defends a single
# replica from unauthenticated floods); the key/org/webhook tiers share counters
# through Postgres so a budget means the same thing across replicas.
# GET /health is never limited, or a traffic spike would fail the healthcheck
# and take the container out of rotation.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_PER_MIN=60
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_KEY_PER_MIN=300
RATE_LIMIT_ORG_PER_MIN=1200
RATE_LIMIT_WEBHOOK_PER_MIN=300

# ------------------------------------------------------------------- jobs
# The in-process SKIP LOCKED worker. Set JOBS_ENABLED=false to run the API
# without it (useful when you want crawls to happen only via the CLI).
JOBS_ENABLED=true
JOBS_CONCURRENCY=4
JOBS_POLL_MS=2000
# SIGTERM waits this long for in-flight handlers before aborting them. The
# compose stop_grace_period (60s) must stay above it.
JOBS_DRAIN_TIMEOUT_MS=45000
# On SIGTERM, /readyz reports 503 immediately and the process keeps serving for
# this long before closing the socket, so the proxy has time to stop routing
# here. Must exceed two of its health-check intervals (compose uses 10s), or a
# redeploy drops the requests still in flight toward us.
DRAIN_DELAY_MS=8000

# ------------------------------------------------------------- connections
# Budget on one VPS Postgres (max_connections=100): api 10 + jobs 5 + migrator 1
# + n8n ~10 + headroom. Splitting the pools is what stops a long crawl from
# starving the gate path. See the header comment in apps/api/src/db.ts.
PG_POOL_WEB=10
PG_POOL_JOBS=5

# ------------------------------------------------------------------ models
# OpenRouter is the only external model provider; embeddings run locally.
# Nothing built so far calls a model — this is consumed by the explainer and the
# agent loops (plans 7 and 10). A missing key fails the prose at the call site,
# never the boot, because the deterministic verdict path uses no model at all.
#
# Free models by default. Both slugs support tool calling and structured
# outputs, which is what the Historian and Reviewer loops need. The free tier is
# capped at 20 requests/minute account wide, and 50 requests/day (1000/day after
# a one time $10 credit purchase). Going paid is a change to these two lines and
# nothing else, because llm.ts is the only module that talks to the provider.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_STRONG=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL_BULK=google/gemma-4-26b-a4b-it:free

# The kill switch. Set to 1 to make every model call fail fast with a typed
# error before any network request — the drill lever and the incident lever.
# The deterministic verdict path is unaffected by design, which is exactly what
# the LLM-off drill proves on every test run.
LLM_DISABLED=0

# Free-tier quotas are hard product constraints, not footnotes. The per-minute
# ceiling is ACCOUNT-WIDE — not per model, not per process, not per loop — so
# one shared token bucket lives in llm.ts and every caller awaits it.
LLM_RPM_LIMIT=20
# 50 on a bare free account; 1000 after the one-time $10 credit, which never
# expires. One 12-edge exit-interview run costs ~60 requests, so it does not
# fit in a free account's whole day even once.
LLM_DAILY_REQUEST_CAP=1000

# ------------------------------------------------------------ historian
# Loop discipline. Two consecutive unparseable model responses end the loop as
# a traced give_up — never as a fabricated rationale.
HISTORIAN_STEP_BUDGET=10
HISTORIAN_MAX_PARSE_FAILURES=2
# Fan-out. Concurrency is *derived* from LLM_RPM_LIMIT and the measured loop
# latency, not asserted — beyond that number loops merely queue inside the
# shared bucket for zero extra throughput.
HISTORIAN_FANOUT_MAX_EDGES=25
HISTORIAN_FANOUT_CONCURRENCY_MAX=5
HISTORIAN_EXPECTED_CALLS_PER_LOOP=5
HISTORIAN_MAX_QUEUED_PER_ORG=50
# Budgets, in both units. On free models the dollar figure is 0.0000 and the
# request count is the only one that can actually stop anything.
HISTORIAN_ORG_BUDGET_USD=20
# Stops one org draining the shared account for every other org.
HISTORIAN_ORG_DAILY_REQUESTS=600
# Bounded fallback scan for orgs without a Slack user token (search.messages
# needs one; bot tokens cannot call it).
SLACK_SCAN_MESSAGES=2000

# ------------------------------------------------------- dev connector seed
# Real orgs store connector credentials per org in the encrypted vault, through
# the app. These exist only so `pnpm seed` can wire the local stack without
# going through a UI — leave them blank and seed just skips those connectors.
#
# n8n mints API keys in its own UI (Settings -> API). There is no endpoint that
# issues one, and Sadhak never pretends to create one for you.
N8N_BASE_URL=
N8N_API_KEY=
# An Airtable personal access token scoped schema.bases:read.
AIRTABLE_TOKEN=
# Historian's GitHub mining reads through this until the App path covers it.
GITHUB_TOKEN=
SLACK_BOT_TOKEN=

# ----------------------------------------------------- platform app secrets
# Platform secrets, not tenant secrets: one GitHub App and one Slack app serve
# every org, and the per-org installation id / OAuth token lives in the vault
# alongside customer credentials.
#
# Absent => that enforcement mode reports itself unavailable. Nothing else is
# affected and the API still boots — the deterministic verdict path needs none
# of this.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# Where Slack sends the browser back after an OAuth grant. Must match the
# redirect URL on the Slack app exactly. In development this is the tunnel
# hostname, e.g. https://something.trycloudflare.com
PUBLIC_API_URL=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# --------------------------------------------------------------- web app
# Baked into the client at build time. Point it wherever the API listens — if
# port 3001 is taken on your machine, change both this and PORT above.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ------------------------------------ VPS deployment (docker-compose.dokploy)
# Not read by the apps; consumed by the compose file, which fails fast if any
# is unset. N8N_ENCRYPTION_KEY belongs in the password manager too: without it,
# a restored n8n database has undecryptable credentials.
#
# GHCR_OWNER is the GitHub org that owns the published images. CI publishes to
# ghcr.io/ashtonmths/sadhak-*, which is also the default here, so an unset value
# deploys the right images. Override it only to pull from somewhere else.
#
# The images must exist and be pullable by the VPS: if the package is private,
# Dokploy needs a registry credential for that org, or the pull 404s no matter
# what this says.
GHCR_OWNER=
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
