# =============================================================================
# Sadhak environment. Copy to .env and fill in the two marked REQUIRED.
#
#   cp .env.example .env
#   echo "CREDENTIAL_MASTER_KEY=v1:$(openssl rand -base64 32)" >> .env
#
# Every variable below is read in exactly one place — apps/api/src/config.ts for
# the API, apps/web/lib/env.ts for the web app — and `pnpm check:env` fails CI if
# this file and that schema ever drift apart.
# =============================================================================

# ------------------------------------------------------------ REQUIRED (api)
# The one variable the API needs to boot. A malformed value exits at startup
# naming this variable, before any connection is opened. The value below is
# already correct for the Postgres in docker-compose.yml.
DATABASE_URL=postgres://sadhak:sadhak@localhost:5432/sadhak

# --------------------------------------------------- REQUIRED (to store creds)
# Seals connector credentials with AES-256-GCM before they touch the database.
# You generate this yourself; it is not issued by any provider:
#
#   echo "v1:$(openssl rand -base64 32)"
#
# Format is v1:<base64 of 32 bytes>. The `v1:` prefix is the key id every
# encrypted row records, which is what makes rotation a config change instead of
# an outage.
#
# Absent => the API still boots and the graph still works, but no credential can
# be stored, so `pnpm seed` connects nothing and there is no crawl.
#
# Back it up in a password manager as well as here. Losing it does not lose
# graph data — nodes, edges and rationale are unencrypted — but every stored
# connector credential becomes unreadable and each connector must be
# reconnected. Use a different key per environment.
# See docs/connectors/README.md.
CREDENTIAL_MASTER_KEY=
# Set only during a rotation window: new writes seal under the current key while
# rows sealed with this one keep opening.
CREDENTIAL_MASTER_KEY_PREVIOUS=

# =============================================================================
# Everything below has a working default. Set it only to change behaviour.
# =============================================================================

# ---------------------------------------------------------------- api server
NODE_ENV=development
PORT=3001

# ------------------------------------------------------------------- auth
# Sessions are opaque tokens over Postgres-backed rows. The dev default is
# insecure on purpose, and production refuses to boot with it (config.ts).
SESSION_SECRET=
# Where the browser app runs. Drives CORS and the session cookie posture.
WEB_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------- jobs
# The in-process SKIP LOCKED worker. Set JOBS_ENABLED=false to run the API
# without it (useful when you want crawls to happen only via the CLI).
JOBS_ENABLED=true
JOBS_CONCURRENCY=4
JOBS_POLL_MS=2000
# SIGTERM waits this long for in-flight handlers before aborting them. The
# compose stop_grace_period (60s) must stay above it.
JOBS_DRAIN_TIMEOUT_MS=45000

# ------------------------------------------------------------- connections
# Budget on one VPS Postgres (max_connections=100): api 10 + jobs 5 + migrator 1
# + n8n ~10 + headroom. Splitting the pools is what stops a long crawl from
# starving the gate path. See the header comment in apps/api/src/db.ts.
PG_POOL_WEB=10
PG_POOL_JOBS=5

# ------------------------------------------------------------------ models
# OpenRouter is the only external model provider; embeddings run locally.
# Nothing built so far calls a model — this is consumed by the explainer and the
# agent loops (plans 7 and 10). A missing key fails the prose at the call site,
# never the boot, because the deterministic verdict path uses no model at all.
#
# Free models by default. Both slugs support tool calling and structured
# outputs, which is what the Historian and Reviewer loops need. The free tier is
# capped at 20 requests/minute account wide, and 50 requests/day (1000/day after
# a one time $10 credit purchase). Going paid is a change to these two lines and
# nothing else, because llm.ts is the only module that talks to the provider.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_STRONG=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL_BULK=google/gemma-4-26b-a4b-it:free

# ------------------------------------------------------- dev connector seed
# Real orgs store connector credentials per org in the encrypted vault, through
# the app. These exist only so `pnpm seed` can wire the local stack without
# going through a UI — leave them blank and seed just skips those connectors.
#
# n8n mints API keys in its own UI (Settings -> API). There is no endpoint that
# issues one, and Sadhak never pretends to create one for you.
N8N_BASE_URL=
N8N_API_KEY=
# An Airtable personal access token scoped schema.bases:read.
AIRTABLE_TOKEN=
# Consumed by plans 8-10 (GitHub gate, Slack alerts and mining). Unused today.
GITHUB_TOKEN=
SLACK_BOT_TOKEN=

# --------------------------------------------------------------- web app
# Baked into the client at build time. Point it wherever the API listens — if
# port 3001 is taken on your machine, change both this and PORT above.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ------------------------------------ VPS deployment (docker-compose.dokploy)
# Not read by the apps; consumed by the compose file, which fails fast if either
# is unset. N8N_ENCRYPTION_KEY belongs in the password manager too: without it,
# a restored n8n database has undecryptable credentials.
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
