# ---------------------------------------------------------------- required
# The only variable the API needs to boot. A malformed value exits at startup
# naming this variable, before any connection is opened.
DATABASE_URL=postgres://sadhak:sadhak@localhost:5432/sadhak

# ------------------------------------------------------------------- auth
# Sessions are opaque tokens over Postgres-backed rows. The dev default is
# insecure on purpose; production refuses to boot with it (see config.ts).
SESSION_SECRET=
# Where the browser app runs. Drives CORS and cookie posture.
WEB_ORIGIN=http://localhost:3000

# ---------------------------------------------------------- credential vault
# Seals connector credentials with AES-256-GCM. Format: v1:<base64 32 bytes>
#   echo "v1:$(openssl rand -base64 32)"
# Absent => credential storage reports itself unavailable and the API still
# boots. Back this key up outside the deployment: losing it does not lose graph
# data, but every stored connector credential becomes unreadable.
# See docs/connectors/README.md.
CREDENTIAL_MASTER_KEY=
# Set during a rotation window: new writes seal under the current key while
# rows sealed with this one keep opening.
CREDENTIAL_MASTER_KEY_PREVIOUS=

# ------------------------------------------------------------------- jobs
JOBS_ENABLED=true
JOBS_CONCURRENCY=4
JOBS_POLL_MS=2000
JOBS_DRAIN_TIMEOUT_MS=45000

# ------------------------------------------------------------- connections
# Budget on one VPS Postgres (max_connections=100): api 10 + jobs 5 + migrator 1
# + n8n ~10 + headroom. See the header comment in apps/api/src/db.ts.
PG_POOL_WEB=10
PG_POOL_JOBS=5

# ------------------------------------------------------------------ models
# OpenRouter is the only external model provider. Embeddings run locally.
#
# Free models by default. Both slugs below support tool calling and structured
# outputs, which is what the Historian and Reviewer loops need. Free tier is
# capped at 20 requests/minute account wide, and 50 requests/day (1000/day after
# a one time $10 credit purchase). Going paid is a change to these two lines and
# nothing else, because llm.ts is the only module that talks to the provider.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_STRONG=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL_BULK=google/gemma-4-26b-a4b-it:free

# ------------------------------------------------------- dev connector seed
# Real orgs store connector credentials in the vault, per org. These exist only
# so `pnpm seed` can wire the local stack without going through the UI.
#
# n8n mints API keys in its own UI (Settings -> API). There is no endpoint that
# issues one, and Sadhak never pretends to create one for you.
N8N_BASE_URL=
N8N_API_KEY=
AIRTABLE_TOKEN=
GITHUB_TOKEN=
SLACK_BOT_TOKEN=

# -------------------------------------------------------------------- web
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- VPS deployment only (docker-compose.dokploy.yml) ---
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
