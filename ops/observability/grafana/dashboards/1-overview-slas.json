    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Reflex — detect and repair SLAs",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Detect p95",
      "datasource": {
        "type": "prometheus",
        "uid": "sadhak-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sadhak-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sadhak_reflex_detect_seconds_bucket[30m])))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 13
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Nothing recorded in this window",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "description": "Upstream change to detection, 95th percentile — 19 of every 20 changes were noticed at least this fast. The published objective is 2s; amber past it, red past 5s.\n\nPercentiles: n% of events were at or under this value.\np50 - the median. Half were faster; this is the typical experience.\np95 - 1 in 20 were slower. Objectives are written against this because it catches a bad tail that an average hides.\np99 - 1 in 100 were slower. The worst realistic case. A p99 far above p95 means a small group of events behaves very differently.\nNo average is shown on purpose: one 10-second outlier and a thousand fast events average to a number nobody experienced."
    },
