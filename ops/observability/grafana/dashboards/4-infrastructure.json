    {
      "type": "stat",
      "title": "Days to cert expiry",
      "datasource": {
        "type": "prometheus",
        "uid": "sadhak-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sadhak-prometheus"
          },
          "expr": "(min(probe_ssl_earliest_cert_expiry) - time()) / 86400",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 13
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "noValue": "Nothing recorded in this window",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 7
              },
              {
                "color": "green",
                "value": 21
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "description": "Days until the soonest TLS certificate expires. Renewal is automatic, so this going red means renewal is broken, not that one is merely due."
    },
    {
      "type": "timeseries",
      "title": "CPU by container",
      "datasource": {
        "type": "prometheus",
        "uid": "sadhak-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sadhak-prometheus"
          },
          "expr": "sum by (name, id) (rate(container_cpu_usage_seconds_total[5m]))",
          "refId": "A",
          "legendFormat": "{{name}}{{id}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
