    {
      "type": "bargauge",
      "title": "Per-minute window used",
      "datasource": {
        "type": "prometheus",
        "uid": "sadhak-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sadhak-prometheus"
          },
          "expr": "max(sadhak_llm_rpm_window_used_ratio)",
          "refId": "B",
          "legendFormat": "rpm window used"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "minVizWidth": 8,
        "minVizHeight": 16,
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "The rpm ceiling is account-wide across every concurrent agent loop, so saturation is a fleet condition — the response is less concurrency, never more retries.\n\nThe daily request cap is deliberately not shown. It is a locally assumed number (LLM_DAILY_REQUEST_CAP), and this key reports is_free_tier=false, so the real ceiling is the credit balance in the Cost row below — not a request count. It is still alerted on."
    },
