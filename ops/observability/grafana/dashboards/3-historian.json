      "description": "How many distinct models actually served a call. OpenRouter routes a slug to whichever provider is free, so this counts what answered rather than what was configured — the two diverge when a saturated :free variant falls back."
    },
    {
      "type": "heatmap",
      "title": "Embedding latency distribution",
      "datasource": {
        "type": "prometheus",
        "uid": "sadhak-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sadhak-prometheus"
          },
          "expr": "sum by (le) (rate(sadhak_embedding_duration_ms_bucket[5m]))",
          "refId": "A",
          "legendFormat": "{{le}}",
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Turbo",
          "steps": 64,
          "reverse": false,
          "fill": "dark-orange",
          "exponent": 0.5,
          "min": 0
        },
        "yAxis": {
          "unit": "ms",
          "axisPlacement": "left"
        },
        "legend": {
          "show": true
        },
        "tooltip": {
          "show": true,
          "yHistogram": true
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "cellValues": {},
        "filterValues": {
          "le": 1e-9
        }
      },
      "description": "Every batch plotted by how long it took; colour is how many landed in that band. Two bright bands means two behaviours, usually a warm model versus a cold one, which any single percentile blends into a misleading middle."
    },
