{
  "uid": "sadhak-agents",
  "title": "Sadhak / Agents and LLM budget",
  "description": "The quota ceilings, and the drift loop's cost. When agents stop, nothing else on any other dashboard moves \u2014 this is where that is visible.",
  "tags": ["sadhak", "agents", "llm"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "utc",
  "panels": [
    {
      "type": "stat",
      "title": "Daily quota remaining",
      "datasource": {
        "type": "prometheus",
        "uid": "sadhak-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sadhak-prometheus"
          },
          "expr": "sadhak_llm_daily_quota_remaining_ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.15
              },
              {
                "color": "green",
                "value": 0.3
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "At zero every agent loop has stopped and verdicts are unaffected. Nothing else alerts. This is why it pages."
    },
    {
      "type": "stat",
      "title": "Per-minute window used",
      "datasource": {
        "type": "prometheus",
        "uid": "sadhak-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sadhak-prometheus"
          },
          "expr": "sadhak_llm_rpm_window_used_ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "Account-wide across every concurrent loop. Saturation means reduce concurrency, never add retries."
    },
    {
      "type": "stat",
      "title": "LLM calls / sec",
      "datasource": {
        "type": "prometheus",
        "uid": "sadhak-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sadhak-prometheus"
          },
          "expr": "sum(rate(sadhak_llm_calls_total[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Drift short-circuit rate",
      "datasource": {
        "type": "prometheus",
        "uid": "sadhak-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sadhak-prometheus"
          },
          "expr": "sum(rate(sadhak_drift_ticks_total{outcome=\"short_circuited\"}[30m])) / clamp_min(sum(rate(sadhak_drift_ticks_total[30m])), 0.0001)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "The ~99% claim, measured rather than asserted. A fall here means the drift loop got expensive."
    },
    {
      "type": "timeseries",
      "title": "Daily quota remaining",
      "datasource": {
        "type": "prometheus",
        "uid": "sadhak-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sadhak-prometheus"
          },
          "expr": "sadhak_llm_daily_quota_remaining_ratio",
          "legendFormat": "remaining",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "percentunit",
          "max": 1
        },
        "overrides": []
      },
      "description": "Slope projects exhaustion. A steep line early in the day is the warning that the fleet is over-provisioned."
    },
    {
      "type": "timeseries",
      "title": "LLM calls by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "sadhak-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sadhak-prometheus"
          },
          "expr": "sum by (outcome) (rate(sadhak_llm_calls_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "LLM calls by caller",
      "datasource": {
        "type": "prometheus",
        "uid": "sadhak-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sadhak-prometheus"
          },
          "expr": "sum by (caller) (rate(sadhak_llm_calls_total[5m]))",
          "legendFormat": "{{caller}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Drift findings and triage",
      "datasource": {
        "type": "prometheus",
        "uid": "sadhak-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sadhak-prometheus"
          },
          "expr": "sum by (outcome) (rate(sadhak_drift_findings_total[30m]))",
          "legendFormat": "finding {{outcome}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sadhak-prometheus"
          },
          "expr": "sum by (outcome) (rate(sadhak_drift_triage_total[30m]))",
          "legendFormat": "triage {{outcome}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      }
    },
    {
      "type": "logs",
      "title": "Agent activity",
      "datasource": {
        "type": "loki",
        "uid": "sadhak-loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "sadhak-loki"
          },
          "expr": "{service=\"api\"} | json | caller =~ \"historian|reviewer|explainer\"",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
