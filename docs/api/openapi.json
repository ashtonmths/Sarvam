          "401": {
            "description": "No credential, or one that no longer resolves.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/ci/{id}": {
      "get": {
        "summary": "One CI failure, with the evidence behind its analysis",
        "tags": [
          "Documents"
        ],
        "description": "Requires `graph:read`. What the Slack alert links to: the failing\nlog, the files the merge changed, the passages the conclusion\nrests on, and any earlier occurrence of the same failure.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The failure and its analysis.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "No credential, or one that no longer resolves.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such failure in this organisation.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents": {
      "get": {
        "summary": "Uploaded documents, with embedding progress",
        "tags": [
          "Documents"
        ],
        "description": "Requires the `graph:read` capability.",
        "responses": {
          "200": {
            "description": "Every document this organisation has uploaded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "No credential, or one that no longer resolves.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Upload a transcript or note for the Historian to search",
        "tags": [
          "Documents"
        ],
        "description": "Requires `connector:manage` — uploading is the act of granting\naccess, the same as picking a Slack channel.\n\nText and markdown only, including subtitle exports. The text is\nchunked on its own boundaries and embedded on a worker, so text\nsearch works immediately and semantic search follows.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "This exact content was already uploaded. Nothing was stored again.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "201": {
            "description": "Stored, with the number of chunks it produced.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "413": {
            "description": "Larger than the upload limit.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unreadable, or not a text format.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/repos": {
