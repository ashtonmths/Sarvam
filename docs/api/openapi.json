      "get": {
        "summary": "Raw changes in a time window",
        "tags": [
          "Changes"
        ],
        "description": "Requires `graph:read`. `from` and `to` are ISO-8601.",
        "responses": {
          "200": {
            "description": "Commits and pull requests, newest first, with paths.",
            "content": {
