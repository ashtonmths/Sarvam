    "/api/org/export": {
      "get": {
        "summary": "Export everything this organisation has",
        "tags": ["Org"],
        "description": "Requires `org:delete`, which only an owner holds. One JSON document:\ngraph, rationale, verdicts, decisions, incidents and the audit log.\n\nCredentials are excluded — they are sealed to this org and connector\nand would not work anywhere else. Embeddings are excluded because\nthey are derived from text already in the file.",
        "responses": {
          "200": {
            "description": "The export, as a file attachment.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "Not an owner.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/org": {
      "delete": {
        "summary": "Delete this organisation and everything in it",
        "tags": ["Org"],
