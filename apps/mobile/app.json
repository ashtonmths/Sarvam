{
  "expo": {
    "name": "Sadhak",
    "slug": "sadhak",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sadhak",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/logo.png",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ebe9e2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "online.sadhak.app"
    },
    "android": {
      "package": "online.sadhak.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ebe9e2"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "apiUrl": "https://api.sadhak.online"
    }
  }
}
